# Machine-specific overrides (.local file pattern)
*.local
*.local.vim
.local/

# Decrypted agent-* config bundles (see lib/secrets.sh).
# The sealed .age blobs and their .sha256 hashes ARE tracked; the plaintext
# working copies never are. *.local / .local/ above do not match this path.
secrets/.open/

# An age identity must never land in the repo. The only key material tracked
# is secrets/identity.age (passphrase-sealed) and secrets/recipients.txt
# (public keys, safe to commit).
keys.txt
*.agekey

# Secrets & keys
id_*
*.key
*.pem
*.p12
*.pfx
private-keys-v1.d/
*.kbx
trustdb.gpg
openpgp-revocs.d/
secring.gpg
S.gpg-agent*
.npmrc
.yarnrc
.yarnrc.yml
.netrc
.env*
known_hosts*
authorized_keys
random_seed
credentials

# Backups
.dotfiles-backup/

# OS artifacts
.DS_Store

# AI cache
.ai-cache/
